true}},"view_serial":100},"class_build_tag":"main34730"},"49343cb7-ffee-4d1e-90a3-0763e05007fc":{"class_fqid":"com-snaplogic-snaps-flow-router_2-main34730","class_id":"com-snaplogic-snaps-flow-router","class_version":2,"instance_fqid":"49343cb7-ffee-4d1e-90a3-0763e05007fc_1","instance_id":"49343cb7-ffee-4d1e-90a3-0763e05007fc","instance_version":1,"property_map":{"info":{"label":{"value":"Router"},"notes":{}},"input":{"input0":{"view_type":{"value":"document"},"label":{"value":"input0"}}},"output":{"output0":{"view_type":{"value":"document"},"label":{"value":"success"}},"output1":{"view_type":{"value":"document"},"label":{"value":"failure"}}},"error":{"error0":{"view_type":{"value":"document"},"label":{"value":"error0"}},"error_behavior":{"value":"fail"}},"settings":{"execution_mode":{"value":"Validate & Execute"},"routes":{"value":[{"expression":{"expression":true,"value":"$customField=='success'"},"outputViewName":{"value":"success"}},{"expression":{"expression":true,"value":"$customField=='failure'"},"outputViewName":{"value":"failure"}}]},"firstMatch":{"value":false}},"view_serial":100},"class_build_tag":"main34730"},"38530400-0352-4d60-a8bb-671d73e80d17":{"class_fqid":"com-snaplogic-snaps-script-script_2-main34730","class_id":"com-snaplogic-snaps-script-script","class_version":2,"instance_fqid":"38530400-0352-4d60-a8bb-671d73e80d17_3","instance_id":"38530400-0352-4d60-a8bb-671d73e80d17","instance_version":3,"property_map":{"info":{"label":{"value":"Script"},"notes":{}},"input":{"input0":{"view_type":{"value":"document"},"label":{"value":"input0"}}},"output":{"output0":{"view_type":{"value":"document"},"label":{"value":"output0"}}},"error":{"error0":{"view_type":{"value":"document"},"label":{"value":"error0"}},"error_behavior":{"value":"fail"}},"settings":{"execution_mode":{"value":"Validate & Execute"},"executable_during_suggest":{"value":false},"language":{"value":"Python"},"script":{"value":null,"expression":false},"editable_content":{"value":"# Import the interface required by the Script snap.\nfrom com.snaplogic.scripting.language import ScriptHook\n\nclass TransformScript(ScriptHook):\n    def __init__(self, input, output, error, log):\n        self.input = input\n        self.output = output\n        self.error = error\n        self.log = log\n\n    # The \"execute()\" method is called once when the pipeline is started\n    # and allowed to process its inputs or just send data to its outputs.\n    def execute(self):\n        self.log.info(\"Executing Transform script\")\n        totalInserted = 0\n        totalUpdated = 0\n        while self.input.hasNext():\n            try:\n                # Read the next input document, store it in a new dictionary, and write this as an output document.\n                inDoc = self.input.next()\n                inserted = inDoc.get('inserted_records')\n                updated = inDoc.get('updated_records')\n                totalInserted = totalInserted + int(inserted)\n                totalUpdated = totalUpdated + int(updated)\n            except Exception as e:\n                errDoc = {\n                    'error' : str(e)\n                }\n                self.log.error(\"Error in python script\")\n                self.error.write(errDoc)\n        outDoc = {'totalInserted': totalInserted, 'totalUpdated': totalUpdated}\n        self.output.write(outDoc)\n        self.log.info(\"Script executed\")\n\n    # The \"cleanup()\" method is called after the snap has exited the execute() method\n    def cleanup(self):\n        self.log.info(\"Cleaning up\")\n\n# The Script Snap will look for a ScriptHook object in the \"hook\"\n# variable.  The snap will then call the hook's \"execute\" method.\nhook = TransformScript(input, output, error, log)\n"}},"view_serial":100},"class_build_tag":"main34730"},"4504079e-e96f-4bd3-b772-36ca5a13e5c2":{"class_fqid":"com-snaplogic-snaps-transform-datatransform_4-main33142","class_id":"com-snaplogic-snaps-transform-datatransform","class_version":4