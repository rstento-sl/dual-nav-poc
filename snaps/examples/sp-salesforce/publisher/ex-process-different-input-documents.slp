mName}\n##  * If you add an input view to the snap, this template will be\n##    evaluated for each input document.\n##  * Fields in the input documents can be referenced by prefixing them\n##    with a dollar-sign ($), like so:\n##      $parent.child[0].value\n##  * Any referenced document values and pipeline parameters will\n##    automatically be JSON-encoded when they are inserted into the final\n##    JSON document.  You should not have to worry about escaping values\n##    yourself.\n##  * If you are having troubles getting a template to produce valid JSON,\n##    you can add an error view to the snap to get a document that\n##    contains the output of the template evaluation."},"arrayElementsAsDocuments":{"value":true}}},"class_build_tag":"SNAPSHOT"},"c7008a39-675e-4621-958c-11ae9df87b30":{"class_fqid":"com-snaplogic-snaps-salesforce-publisher_1-SNAPSHOT","class_id":"com-snaplogic-snaps-salesforce-publisher","class_version":1,"instance_fqid":"c7008a39-675e-4621-958c-11ae9df87b30_24","instance_id":"c7008a39-675e-4621-958c-11ae9df87b30","instance_version":24,"property_map":{"info":{"notes":{"value":null},"label":{"value":"Salesforce Publisher"}},"view_serial":101,"account":{"account_ref":{"expression":false,"value":{"label":{"expression":false,"value":"snaplogic2013"},"ref_class_id":{"value":"com-snaplogic-snaps-salesforce-salesforceaccount"},"ref_id":{"expression":false,"value":"8f4ce1d0-3cf7-4841-8669-c41bb9902463"}}}},"input":{"input0":{"view_type":{"value":"document"},"label":{"value":"input0"}}},"settings":{"retryInterval":{"expression":true,"value":"_interval"},"passThrough":{"value":true},"batchSize":{"expression":true,"value":"_batchSize"},"executable_during_suggest":{"value":true},"serviceVersion":{"value":"44.0"},"numberOfRetries":{"expression":true,"value":"_retries"},"salesforceApi":{"value":"REST API"},"objectType":{"expression":true,"value":"_event"}},"error":{"error0":{"view_type":{"value":"document"},"label":{"value":"error0"}},"error_behavior"