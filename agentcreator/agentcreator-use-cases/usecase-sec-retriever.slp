iginal.prompt","expression":true},"targetPath":{"value":"$prompt"}}]}}},"promptTemplate":{"value":"Context Q & A"},"nullSafeAccess":{"value":false}},"view_serial":100},"class_build_tag":"SNAPSHOT"},"a1bae84b-b4cf-4b69-a683-c2fb5a3830ae":{"class_fqid":"com-snaplogic-snaps-transform-jsongenerator_2-main26341","class_id":"com-snaplogic-snaps-transform-jsongenerator","class_version":2,"instance_fqid":"a1bae84b-b4cf-4b69-a683-c2fb5a3830ae_4","instance_id":"a1bae84b-b4cf-4b69-a683-c2fb5a3830ae","instance_version":4,"property_map":{"info":{"label":{"value":"JSON Generator"},"notes":{}},"output":{"output0":{"view_type":{"value":"document"},"label":{"value":"output0"}}},"error":{"error0":{"view_type":{"value":"document"},"label":{"value":"error0"}},"error_behavior":{"value":"fail"}},"settings":{"execution_mode":{"value":"Validate & Execute"},"editable_content":{"value":"## Enter your JSON-encoded data in this space.  Note that this text is\n## treated as an Apache Velocity template, so you can substitute values\n## from input documents or the pipeline parameters.  See the following\n## URL for more information about Velocity:\n##   https://velocity.apache.org/engine/devel/user-guide.html\n\n[\n    {\n        \"prompt\" : \"What product did apple relase in each quarter?\"\n    }\n]\n\n\n## Tips:\n##  * The sample data above will generate a single empty document, uncomment\n##    the line in the middle to include the sample fields.  Adding more\n##    objects to the root array will cause the snap to generate more\n##    than one document.\n##  * Pipeline parameters can be referenced by prefixing the parameter\n##    name with an underscore, like so:\n##      ${_pipelineParamName}\n##  * If you add an input view to the snap, this template will be\n##    evaluated for each input document.\n##  * Fields in the input documents can be referenced by prefixing them\n##    with a dollar-sign ($), like so:\n##      $parent.child[0].value\n##  * Any referenced document values and pipeline parameters will\n##    automatically be JSON-encoded when they are inserted into the final\n##    JSON document.  You should not have to worry about escaping values\n##    yourself.\n##  * If you are having troubles getting a template to produce valid JSON,\n##    you can add an error view to the snap to get a document that\n##    contains the output of the template evaluation.\n"},"arrayElementsAsDocuments":{"value":true},"passThroughProp":{"value":false},"supportTypeExts":{"value":false}},"view_serial":100,"input":{}},"class_build_tag":"main26341"},"548fa72e-0e87-49ad-924a-8b0e0f811bb3":{"class_fqid":"com-snaplogic-snaps-awsbedrock-awsbedrockpromptgenerator_1-PR27142","class_id":"com-snaplogic-snaps-awsbedrock-awsbedrockpromptgenerator","class_version":1,"instance_fqid":"548fa72e-0e87-49ad-924a-8b0e0f811bb3_1","instance_id":"548fa72e-0e87-49ad-924a-8b0e0f811bb3","instance_version":1,"property_map":{"info":{"label":{"value":"Amazon Bedrock Prompt Generator"},"notes":{}},"input":{"input0":{"view_type":{"value":"document"},"label":{"value":"input0"}}},"output":{"output0":{"view_type":{"value":"document"},"label":{"value":"output0"}}},"error":{"error0":{"view_type":{"value":"document"},"label":{"value":"error0"}},"error_behavior":{"value":"fail"}},"settings":{"execution_mode":{"value":"Validate & Execute"},"promptTemplate":{"value":"Context Q & A"},"editable_content":{"value":"Instruction: Please answer the question based on the following context.\nIf the question cannot be answered using the information provided, answer with I don’t know.\nPlease add the following information to the end of the answer:\nThe related context is retrieved from the following sources: {{source}}\nContext: {{#data}}{{{.}}}{{/data}}\nQuestion: {{prompt}} \nAnswer:"},"role":{"value":"USER","expression":false},"advancedMode":{"value":false}},"view_serial":100},"class_build_tag":"PR27142"},"ac9e8f8f-2edc-4467-a9b8-4eb34c1ceab9":{"class_fqid":"com-snaplogic-snaps-awsbedrock-awsclaudemessages_